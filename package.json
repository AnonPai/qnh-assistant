{
  "name": "qnh-assistant",
  "version": "0.1.1",
  "private": true,
  "description": "美团牵牛花跨账号商品同步助手 (Edge 插件)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev --watch",
    "start": "node scripts/build.mjs --watch",
    "build": "tsc -b --noEmit && node scripts/build.mjs",
    "typecheck": "tsc -b --noEmit",
    "zip": "node scripts/zip-dist.mjs",
    "crx": "node scripts/pack-crx.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "crx3": "^2.0.0",
    "esbuild": "^0.24.2",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
